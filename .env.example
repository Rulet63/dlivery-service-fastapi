# DATABASE (внутри docker-compose сети host=mysql)
DATABASE_URL=mysql+asyncmy://root:password@mysql:3306/delivery_db
SQLALCHEMY_ECHO=false

# REDIS (внутри docker-compose сети host=redis)
REDIS_URL=redis://redis:6379/0
CURRENCY_CACHE_TTL=3600

# APP
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# EXTERNAL API
CURRENCY_API_URL=https://www.cbr-xml-daily.ru/daily_json.js

# SCHEDULER
SCHEDULER_INTERVAL_MINUTES=5
SCHEDULER_RUN_ONCE=false
